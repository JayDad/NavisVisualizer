<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 소스 설정 — 사내망(인터넷 차단) 빌드 대응 (2026-09).
  packages-offline\ 폴더에 이 프로젝트가 쓰는 패키지(.nupkg)를 통째로 넣어 두었으므로
  api.nuget.org에 못 닿아도 복원이 된다. deploy.bat이 restore를 -ignore-failed-sources로 돌려
  nuget.org 실패(NU1301)를 경고로 낮추고 로컬 폴더에서 해결한다.
  새 PackageReference를 추가하면 그 .nupkg(의존 패키지 포함)도 packages-offline에 같이 넣을 것.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="offline" value="packages-offline" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
