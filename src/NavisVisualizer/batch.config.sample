# NavisVisualizer 일괄 갱신(배치) 설정 — 예시
# 실제 파일 위치: %APPDATA%\NavisVisualizer\batch.config  (deploy.bat이 없을 때만 이 샘플을 복사)
# 실행 창에서 마지막 선택(enabled/disciplines)을 자동으로 되써 넣으므로, 손으로 고칠 것은
# model 경로 · project · outputFolder 정도. 백슬래시 그대로, 따옴표 없이 적는다.

[settings]
# 저장 폴더. 비우면 각 모델 파일과 같은 폴더에 저장 — 프로젝트마다 공유 폴더가 달라 비워 둔다.
# (Trion = Export_NWD\생산공유, RUYA = Export_Ruya_NWD). job별로 output= 으로 따로 지정할 수도 있다.
# 네트워크 드라이브(Z:)는 로그인한 사용자에게 매핑돼 있어야 한다.
outputFolder=
# 토큰: {modelbase}=모델명에서 끝 _날짜(yyMMdd/yyyyMMdd) 제거 {model}=모델명 {name}=job 이름
#       {date}=yyyyMMdd {time}=HHmm — {date:yyMMdd}처럼 서식 지정 가능. .nwd 자동
# 예) 99-Trion_Topsides_김의택책임님참고_260910.nwd → 99-Trion_Topsides_김의택책임님참고_260914.nwd
#     RUYA-progress_260911.nwd                       → RUYA-progress_260914.nwd
fileNamePattern={modelbase}_{date:yyMMdd}

[job:Trion]
model=Z:\06.PM\19. Digitalization\NavisVisualizer\Export_NWD\생산공유\99-Trion_Topsides_김의택책임님참고_260910.nwd
# OASIS PJTNO/PRJTNO. 프로젝트 2개라 job마다 지정 (Trion=Q557 · RUYA=Q558). 비우면 oasis.config의 project 사용
project=Q557
# 비우면 [settings] outputFolder → 그것도 비면 모델과 같은 폴더
output=
enabled=true
# 가능값: Spool, Hydrotest, Equipment, EitTray, Cable  (실행 창 체크박스의 초기 상태 — 실행 시 자동 갱신)
disciplines=Spool,Hydrotest

[job:RUYA]
model=Z:\06.PM\19. Digitalization\NavisVisualizer\Export_Ruya_NWD\RUYA-progress_260911.nwd
project=Q558
output=
enabled=true
disciplines=Spool,Hydrotest
