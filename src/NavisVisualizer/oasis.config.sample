# OASIS(사내 SQL Server) 연결 설정
# 이 파일을 "oasis.config"로 복사해 플러그인 DLL과 같은 폴더에 배포한다.
# 개인 PC별 예외: %APPDATA%\NavisVisualizer\oasis.config 가 있으면 그 파일이 우선.
#
# 보안: 사내망 전용 전제로 암호를 평문 보관한다.
#       DB 계정은 반드시 SELECT 전용(읽기 전용)으로 발급할 것.
#       예: GRANT SELECT ON SCHEMA::Navis TO navis_ro;

server=192.168.0.0
database=TEST_NAVIS
user=navis_ro
password=CHANGE_ME

# 시작 시 선택될 공사(PJTNO/PRJTNO). 비우면 "전체"로 시작한다.
# 실행 중에는 각 탭의 공사 드롭다운으로 바꿀 수 있으며, 그 선택은 저장되지 않는다
# (Navisworks를 다시 열면 이 값으로 돌아옴).
project=Q557

# 드롭다운에 표시할 공사명. Q557=Trion, Q558=Ruya는 코드에 내장돼 있어 안 적어도 된다.
# 공사가 추가되면 아래 형식으로 한 줄 넣으면 재빌드 없이 드롭다운에 나온다.
# (공사명은 DB에 없다 — 이 파일이 이름의 원천.)
#project.Q559=공사명

# Windows 인증을 쓰려면 아래 주석 해제 (user/password 무시됨)
#integrated=true

# 접속 타임아웃(초). 서버 무응답 시 Navisworks가 이 시간만큼 멈추므로 짧게 유지.
#timeout=5
